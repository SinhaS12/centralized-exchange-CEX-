generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CATEGORY {
  LIMIT
  MARKET
}

enum TYPE {
  BID
  ASK
}

enum STATUS {
  OPEN
  FILLED
  CANCELLED
}

enum MARKET_TYPE {
  SPOT
  PERP
}

enum POSITION_SIDE {
  LONG
  SHORT
}

model User {
  id              Int                @id @default(autoincrement())
  username        String
  password        String
  email           String             @unique
  Order           Order[]
  Fills           Fills[]
  balances        AssetBalance[]
  positions       PerpPosition[]
  fundingPayments FundingPayment[]
  liquidations    LiquidationEvent[]
}

model Stocks {
  id          Int     @id @default(autoincrement())
  StockName   String  @unique
  StockSymbol String  @unique
  Order       Order[]
}

model Order {
  id           Int         @id @default(autoincrement())
  user         Int
  Stock        Int
  StockName    String
  category     CATEGORY
  type         TYPE
  status       STATUS
  marketType   MARKET_TYPE @default(SPOT)
  legacyAmount Decimal?    @map("amount") @db.Decimal(65, 30)
  price        Decimal?    @db.Decimal(30, 8)
  volume       Decimal     @db.Decimal(30, 8)
  remaining    Decimal     @default(0) @db.Decimal(30, 8)
  leverage     Int         @default(1)
  reduceOnly   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  userId       User        @relation(fields: [user], references: [id])
  StockId      Stocks      @relation(fields: [Stock], references: [id])
  Fills        Fills[]

  @@index([Stock, marketType, status, type, price, createdAt])
  @@index([user, status, createdAt])
}

model Fills {
  id             Int         @id @default(autoincrement())
  order          Int
  user           Int
  asset          String
  category       CATEGORY
  type           TYPE
  legacyQuantity Int         @map("Quantity")
  quantity       Decimal     @db.Decimal(30, 8)
  price          Decimal     @db.Decimal(30, 8)
  orginalOrderId Int
  marketType     MARKET_TYPE @default(SPOT)
  createdAt      DateTime    @default(now())
  orderId        Order       @relation(fields: [order], references: [id])
  userId         User        @relation(fields: [user], references: [id])

  @@index([asset, marketType, createdAt])
}

model AssetBalance {
  id        Int      @id @default(autoincrement())
  userId    Int
  asset     String
  available Decimal  @default(0) @db.Decimal(30, 8)
  locked    Decimal  @default(0) @db.Decimal(30, 8)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asset])
}

model PerpPosition {
  id               Int           @id @default(autoincrement())
  userId           Int
  symbol           String
  side             POSITION_SIDE
  quantity         Decimal       @db.Decimal(30, 8)
  entryPrice       Decimal       @db.Decimal(30, 8)
  margin           Decimal       @db.Decimal(30, 8)
  leverage         Decimal       @db.Decimal(10, 4)
  liquidationPrice Decimal       @db.Decimal(30, 8)
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([symbol, side])
}

model FundingPayment {
  id        Int      @id @default(autoincrement())
  userId    Int
  symbol    String
  amount    Decimal  @db.Decimal(30, 8)
  rate      Decimal  @db.Decimal(12, 8)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([symbol, createdAt])
  @@index([userId, createdAt])
}

model FundingSettlement {
  id           Int      @id @default(autoincrement())
  symbol       String
  settlementAt DateTime
  createdAt    DateTime @default(now())

  @@unique([symbol, settlementAt])
}

model LiquidationEvent {
  id        Int           @id @default(autoincrement())
  userId    Int
  symbol    String
  side      POSITION_SIDE
  quantity  Decimal       @db.Decimal(30, 8)
  price     Decimal       @db.Decimal(30, 8)
  loss      Decimal       @db.Decimal(30, 8)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([symbol, createdAt])
  @@index([userId, createdAt])
}
